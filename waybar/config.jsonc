// -*- mode: jsonc -*-
{
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 30, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 4, // Gaps between modules (4px)
  // Choose the order of the modules

  "include": ["~/.config/dotfiles/waybar/modules.jsonc"],

  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "hyprland/window"
    // "sway/mode",
    // "sway/scratchpad",
    // "custom/media"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    // "mpd",
    // "idle_inhibitor",
    // "cpu",
    // "memory",
    // "temperature",
    "backlight",
    // "keyboard-state",
    // "sway/language",
    // "custom/keyboard-layout",
    // "custom/updates",
    // "battery#bat2",
    "pulseaudio",
    "network",
    "power-profiles-daemon",
    // "bluetooth",
    "group/hardware",
    "battery",
    "tray"
    // "custom/power"
  ]
}
